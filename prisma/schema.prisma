// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../server/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum BoardScope {
  NATIONAL
  STATE
}

enum BoardStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum BidStatus {
  PENDING
  ACTIVE
  REVERSED
}

enum WebhookEventStatus {
  PROCESSED
  IGNORED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  businesses Business[]
  sessions   AuthSession[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  businesses Business[]
  boards     Board[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  id              String         @id @default(uuid())
  ownerId         String?
  manageTokenHash String?        @unique
  categoryId      String

  name            String
  slug            String         @unique
  description     String?

  website         String?
  contactEmail    String?
  contactPhone    String?
  logoUrl         String?

  country         String         @default("IN")
  state           String?
  city            String?

  status          BusinessStatus @default(ACTIVE)

  owner    User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  category Category  @relation(fields: [categoryId], references: [id])

  memberships BoardMembership[]
  payments    Payment[]
  clicks      Click[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([manageTokenHash])
  @@index([city, state, country])
}

model Board {
  id         String     @id @default(uuid())
  categoryId String
  key        String     @unique
  name       String
  scope      BoardScope @default(NATIONAL)

  country String? @default("IN")
  state   String?
  city    String?

  minBidPaise       BigInt @default(10000)
  bidIncrementPaise BigInt @default(100)

  status BoardStatus @default(ACTIVE)

  category Category @relation(fields: [categoryId], references: [id])

  memberships BoardMembership[]
  clicks      Click[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([scope, state])
  @@index([status])
}

model BoardMembership {
  id String @id @default(uuid())

  businessId String
  boardId    String

  totalSpendPaise BigInt    @default(0)
  lastBidAt       DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  bids     Bid[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, boardId])
  @@index([businessId])
  @@index([boardId])
}

model Payment {
  id String @id @default(uuid())

  businessId    String
  membershipId  String
  initiatedById String?

  provider          String  @default("razorpay")
  providerOrderId   String? @unique
  providerPaymentId String? @unique

  idempotencyKey String @unique

  amountPaise BigInt
  currency    String @default("INR")

  status PaymentStatus @default(CREATED)

  failureReason String?

  providerRefundId String?
  refundReason     String?
  refundedAt       DateTime?

  expiresAt DateTime?

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership  BoardMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  initiatedBy User?           @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  bid Bid?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([membershipId])
  @@index([initiatedById])
  @@index([status])
  @@index([expiresAt])
}

model Bid {
  id String @id @default(uuid())

  membershipId String
  paymentId    String @unique

  amountPaise BigInt
  status      BidStatus @default(ACTIVE)

  membership BoardMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  payment    Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([membershipId, status])
}

model Click {
  id String @id @default(uuid())

  businessId String
  boardId    String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([boardId, createdAt])
}

model AuthSession {
  id        String @id @default(uuid())
  userId    String
  tokenHash String @unique
  familyId  String @default(uuid())

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PaymentWebhookEvent {
  id String @id @default(uuid())

  provider  String
  eventId   String
  eventType String

  providerOrderId   String?
  providerPaymentId String?

  status WebhookEventStatus

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}
